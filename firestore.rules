rules_version = '2';

// Règles Firestore pour Compta Manager.
// Le site exige un code PIN avant d'afficher quoi que ce soit, et se connecte
// ensuite anonymement à Firebase (auth.currentUser existe mais sans email/mdp).
// Ces règles bloquent donc tout accès direct à la base par un client qui n'est
// pas passé par l'application (ex. requêtes REST anonymes non authentifiées).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
